<style>
  /* Libron (OFL, github.com/nicoverbruggen/libron), served unmodified from GitHub Pages.
     The metric overrides pin line boxes so the spacing below is exact. */
  @font-face {
    font-family: "Libron";
    font-style: normal;
    font-weight: 400;
    src: url("https://johnlago.github.io/patent-wallpapers/plugin/fonts/Libron-Regular.woff2") format("woff2");
    ascent-override: 80%; descent-override: 20%; line-gap-override: 0%;
  }
  @font-face {
    font-family: "Libron";
    font-style: italic;
    font-weight: 400;
    src: url("https://johnlago.github.io/patent-wallpapers/plugin/fonts/Libron-Italic.woff2") format("woff2");
    ascent-override: 80%; descent-override: 20%; line-gap-override: 0%;
  }

  .pw-layout { position: relative; padding: 0 !important; }
  .pw { position: absolute; inset: 0; container-type: size; overflow: hidden; }

  /* One canvas per layout, in that layout's own pixels (--rw x --rh) scaled to the
     slot: --u is one reference pixel. Everything inside is placed in --u, so the
     layout keeps its proportions on any device. */
  .pw-canvas {
    --u: min(calc(100cqw / var(--rw)), calc(100cqh / var(--rh)));
    position: absolute; left: 50%; top: 50%;
    width: calc(var(--rw) * var(--u)); height: calc(var(--rh) * var(--u));
    transform: translate(-50%, -50%);
    font-family: "Libron", Georgia, serif; font-weight: 400;
    font-kerning: normal; font-synthesis: none;
  }
  .pw-box {
    position: absolute;
    left: calc(var(--x) * var(--u)); top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u));
  }
  .pw-drawing { object-fit: contain; }

  /* Caption lines are spaced by baseline and cap height, as in the Image Display
     set: --lg is the gap from one line's baseline to the next line's cap height.
     With ascent 0.8, descent 0.2 and cap height 0.698 em, a line box of
     line-height L has (L-1)/2 + 0.102 em above the cap height and
     (L-1)/2 + 0.2 em below the baseline. Header and inventors use L = 1.3,
     the title 1.22. */
  .pw-caption { display: flex; flex-direction: column; text-align: center; }
  .pw-rule {
    flex: none; align-self: center; width: calc(2 * var(--rw2) * var(--u));
    border-top: max(1px, calc(1 * var(--u))) solid #000;
  }
  .pw-header, .pw-title, .pw-inventors { flex: none; }
  .pw-header > span, .pw-title > span { display: block; white-space: pre; }
  .pw-header { font-size: calc(var(--hs) * var(--u)); line-height: 1.3; margin-top: calc(-0.252 * var(--hs) * var(--u)); }
  .pw-rule + .pw-header { margin-top: calc((var(--rg) - 0.252 * var(--hs)) * var(--u)); }
  .pw-title {
    font-style: italic; font-size: calc(var(--ts) * var(--u)); line-height: 1.22;
    margin-top: calc((var(--lg) - 0.35 * var(--hs) - 0.212 * var(--ts)) * var(--u));
  }
  .pw-inventors > span { display: block; white-space: pre; }
  .pw-inventors {
    font-size: calc(var(--is) * var(--u)); line-height: 1.3;
    margin-top: calc((var(--lg) - 0.31 * var(--ts) - 0.252 * var(--is)) * var(--u));
    margin-bottom: calc(-0.09 * var(--is) * var(--u));
  }
  .pw-title:last-child { margin-bottom: calc(-0.05 * var(--ts) * var(--u)); }

  /* Once the script below has painted a caption onto its canvas, the DOM text stays
     for layout but no longer draws. */
  .pw-painted .pw-header, .pw-painted .pw-title, .pw-painted .pw-inventors { color: transparent; }
  .pw-paint { position: absolute; pointer-events: none; }

  .pw-empty {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-style: italic; font-size: calc(20 * var(--u));
  }
</style>

<script>
  // TRMNL's renderer draws page text without antialiasing (hard black/white edges,
  // even on 4-gray screens), while images it scales get gray edges. So each caption
  // line is drawn onto a canvas at 4x, scaled down (which makes the gray edges) and
  // darkened like the Image Display captions (gamma 1.7), then laid over the DOM
  // text, which keeps the layout. If the font or canvas fails, the DOM text stays.
  document.addEventListener("DOMContentLoaded", function () {
    if (window.__pwPaint) return;  // shared markup runs once per view in a mashup
    window.__pwPaint = true;
    var faces = ['400 16px "Libron"', 'italic 400 16px "Libron"'];
    Promise.all(faces.map(function (f) { return document.fonts.load(f); }))
      .then(function () {
        if (!faces.every(function (f) { return document.fonts.check(f); })) return;
        document.querySelectorAll(".pw-caption").forEach(pwPaint);
      })
      .catch(function () {});
  });

  function pwPaint(cap) {
    var SS = 4, GAMMA = 1.7, dpr = window.devicePixelRatio || 1;
    var spans = cap.querySelectorAll(".pw-header > span, .pw-title > span, .pw-inventors > span");
    if (!spans.length) return;
    // Paint area: the text lines plus room for italic overhang and descenders,
    // kept inside the slot so nothing spills into a neighbouring mashup view.
    var box = cap.getBoundingClientRect(), slot = cap.closest(".pw").getBoundingClientRect();
    var L = Infinity, T = Infinity, R = -Infinity, B = -Infinity;
    spans.forEach(function (el) {
      var r = el.getBoundingClientRect(), m = 0.3 * parseFloat(getComputedStyle(el).fontSize);
      L = Math.min(L, r.left - m); T = Math.min(T, r.top - m); R = Math.max(R, r.right + m); B = Math.max(B, r.bottom + m);
    });
    L = Math.max(L, slot.left); T = Math.max(T, slot.top); R = Math.min(R, slot.right); B = Math.min(B, slot.bottom);
    // Canvas origin on a device pixel, so the bitmap isn't resampled again.
    var x0 = Math.ceil(L * dpr) / dpr, y0 = Math.ceil(T * dpr) / dpr;
    var w = Math.floor((R - x0) * dpr), h = Math.floor((B - y0) * dpr);
    if (w <= 0 || h <= 0) return;

    var big = document.createElement("canvas");
    big.width = w * SS; big.height = h * SS;
    var g = big.getContext("2d");
    g.scale(SS * dpr, SS * dpr);
    g.translate(-x0, -y0);
    g.textAlign = "center"; g.textBaseline = "alphabetic";
    spans.forEach(function (el) {
      var r = el.getBoundingClientRect(), cs = getComputedStyle(el);
      var size = parseFloat(cs.fontSize), lead = parseFloat(cs.lineHeight);
      g.font = cs.fontStyle + " 400 " + size + 'px "Libron"';
      g.fillStyle = cs.color;  // the text's own color, so dark mode still works
      // Libron's ascent is pinned to 0.8 em (see @font-face), so this is the baseline.
      g.fillText(el.textContent, r.left + r.width / 2, r.top + (lead - size) / 2 + 0.8 * size);
    });

    // Halve twice: each 2:1 step averages 2x2 pixels, so 4x -> 1x is a 4x4 box filter.
    var src = big;
    [2, 1].forEach(function (k) {
      var c = document.createElement("canvas");
      c.width = w * k; c.height = h * k;
      var cg = c.getContext("2d");
      cg.imageSmoothingEnabled = true; cg.imageSmoothingQuality = "high";
      cg.drawImage(src, 0, 0, c.width, c.height);
      src = c;
    });
    var out = src, og = out.getContext("2d"), img = og.getImageData(0, 0, w, h), d = img.data;
    var lut = new Uint8ClampedArray(256);  // ink coverage -> darkened (bolder) coverage
    for (var a = 0; a < 256; a++) lut[a] = 255 - Math.round(255 * Math.pow((255 - a) / 255, GAMMA));
    for (var i = 3; i < d.length; i += 4) d[i] = lut[d[i]];
    og.putImageData(img, 0, 0);

    out.className = "pw-paint";
    out.style.left = (x0 - box.left) + "px"; out.style.top = (y0 - box.top) + "px";
    out.style.width = (w / dpr) + "px"; out.style.height = (h / dpr) + "px";
    cap.appendChild(out);
    cap.classList.add("pw-painted");
  }
</script>

{% comment %}
  One patent in one layout. layout = the view's name, p = its plan from the manifest
  (a, d, c, h, t, ts, i), r = its reference size and caption style. Positions go in a
  <style> scoped to layout + patent id, so two of these in one mashup can't clash.
{% endcomment %}
{% template patent %}
{% assign k = layout | append: "-" | append: id %}
{% if p.a == "side" %}{% assign lg = r.slg %}{% else %}{% assign lg = r.lg %}{% endif %}
<style>
  .pw-{{ k }} .pw-canvas { --rw: {{ r.w | default: 800 }}; --rh: {{ r.h | default: 480 }}; }
  .pw-{{ k }} .pw-drawing { --x: {{ p.d[0] }}; --y: {{ p.d[1] }}; --w: {{ p.d[2] }}; --h: {{ p.d[3] }}; }
  .pw-{{ k }} .pw-caption {
    --x: {{ p.c[0] }}; --y: {{ p.c[1] }}; --w: {{ p.c[2] }}; --h: {{ p.c[3] }};
    --hs: {{ r.hs }}; --ts: {{ p.ts }}; --is: {{ r.is }}; --lg: {{ lg }}; --rg: {{ r.rg }}; --rw2: {{ r.rw }};
  }
</style>
<div class="layout pw-layout">
  <div class="pw pw-{{ k }}">
    <div class="pw-canvas">
      {% if p and image_url %}
        <img class="image pw-box pw-drawing" src="{{ image_url }}" alt="">
        <div class="pw-box pw-caption">
          {% if r.rule %}<div class="pw-rule"></div>{% endif %}
          <div class="pw-header">{% for line in p.h %}<span>{{ line }}</span>{% endfor %}</div>
          <div class="pw-title">{% for line in p.t %}<span>{{ line }}</span>{% endfor %}</div>
          {% if p.i.size > 0 %}<div class="pw-inventors">{% for line in p.i %}<span>{{ line }}</span>{% endfor %}</div>{% endif %}
        </div>
      {% else %}
        <div class="pw-empty">{{ error | default: "No patent to show yet." }}</div>
      {% endif %}
    </div>
  </div>
</div>
{% endtemplate %}
